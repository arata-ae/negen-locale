{
  "name": "@negen/locale",
  "description": "Traditional Chinese, Japanese and Korean for the DeepSeek Harness Web UI. Replaces the built-in locale plugin with a widened roster.",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arata-ae/negen-locale.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh",
    "locale",
    "i18n",
    "cjk",
    "zh-TW",
    "繁體中文",
    "日本語",
    "한국어"
  ],
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:fork": "node scripts/verify-fork.mjs",
    "verify:dicts": "node scripts/verify-dicts.mjs",
    "verify": "node scripts/verify.mjs",
    "test": "node --test tests/*.test.ts",
    "chars": "node scripts/collect-chars.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-client-connection": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": ">=0.1.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-api-remotes": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.1-rc.2",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "esbuild": "^0.25.0",
    "react": "^18.2.0",
    "typescript": "~5.9.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "UPSTREAM.md",
    "README.md",
    "LICENSE"
  ]
}
