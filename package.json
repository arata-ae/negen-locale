{
  "name": "@negen/locale",
  "description": "Traditional Chinese, Japanese and Korean for the DeepSeek Harness Web UI, as a language pack over the built-in locale plugin.",
  "version": "0.3.0",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arata-ae/negen-locale.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh",
    "locale",
    "i18n",
    "cjk",
    "zh-TW",
    "\u7e41\u9ad4\u4e2d\u6587",
    "\u65e5\u672c\u8a9e",
    "\ud55c\uad6d\uc5b4"
  ],
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:fork": "node scripts/verify-fork.mjs",
    "verify:dicts": "node scripts/verify-dicts.mjs",
    "verify": "node scripts/verify.mjs",
    "test": "node --test tests/*.test.ts",
    "chars": "node scripts/collect-chars.mjs",
    "worklist": "node scripts/worklist.mjs",
    "check": "node scripts/check-translations.mjs",
    "merge": "node scripts/merge-translations.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4",
    "@deepseek-ai/dsh-client-locale": ">=0.2.0-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "~5.9.0"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "UPSTREAM.md",
    "README.md",
    "LICENSE"
  ]
}
